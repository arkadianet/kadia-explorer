# Production Caddy site config for explorer.kadia.io (Nuremberg).
#
# Deployed by `scripts/deploy_frontend.sh --caddy`, which scp's this file to
# /etc/caddy/Caddyfile after `caddy validate` on the host, then reloads Caddy.
#
# Caching: the SvelteKit app is a single-page app served from a static build. Everything under
# /_app/immutable/* is content-hashed and may be cached forever; every *other* response —
# index.html, the SPA fallback for client-side routes such as /blocks/1000, favicon, robots.txt
# — must be revalidated on each load, or a browser keeps serving a stale shell that points at
# hashed chunks a later deploy has already pruned. `header` matchers run before `try_files`, so
# @notimmutable sees the request's original path, not the rewritten /index.html.
explorer.kadia.io {
	encode zstd gzip

	# The explorer API (xp-api) — same origin, so the app can call /v1 without CORS.
	handle /v1/* {
		reverse_proxy 127.0.0.1:18090
	}

	handle {
		root * /var/www/explorer

		@immutable path /_app/immutable/*
		@notimmutable not path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @notimmutable Cache-Control "no-cache"

		# Client-side routes have no file on disk; serve the SPA shell for them.
		try_files {path} /index.html
		file_server
	}
}
# Public Ergo node API for node.kadia.io (Nuremberg, main build 0.7.0, no rent collector).
#
# DEFAULT DENY. The node itself stays bound to 127.0.0.1:9063; nothing new listens
# publicly. Only the routes in @allowed are proxied, everything else gets 403, so a
# future node release that adds a route does not silently become public.
#
# Deliberate denials:
#   /blockchain/storageRent*  - enumerates eligible rent boxes; would do a competitor's
#                               research for them. Whole subtree reserved, not just the
#                               three routes that exist today.
#   /api/v1/*                 - native tree: accounts/private-key, watch registry,
#                               mempool reads labelled by producer, host RSS/CPU/disk,
#                               batch (which can reach those mempool reads), webhooks.
#   /wallet* /scan* /node* /mining*  - privileged or lets a caller steer the node.
#   POST /blocks, /peers/connect     - block submission and peer steering.
#   /metrics                  - operational counters.
# These are gateway rules, not a claim the node lacks its own auth.
node.kadia.io {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "600"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@preflight method OPTIONS

	# Checked before @allowed, so /blockchain/* cannot leak the rent subtree.
	@denied path /blockchain/storageRent /blockchain/storageRent/*

	@allowed {
		path /info
		path /blocks /blocks/*
		path /blockchain/*
		path /transactions /transactions/bytes /transactions/check /transactions/checkBytes
		path /transactions/getFee /transactions/waitTime /transactions/poolHistogram
		path /transactions/unconfirmed /transactions/unconfirmed/*
		path /utxo/*
		path /peers/status
	}

	route {
		respond @preflight 204
		respond @denied 403
		reverse_proxy @allowed 127.0.0.1:9063
		respond 403
	}
}
